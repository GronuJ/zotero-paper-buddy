{
  "manifest_version": 2,
  "name": "Paper Buddy for Zotero",
  "version": "0.6.0",
  "description": "Ask Claude or another AI model about passages you highlight. The answer appears in the reader sidebar.",
  "author": "Jost",
  "icons": {
    "48": "content/icons/claude.svg",
    "96": "content/icons/claude.svg"
  },
  "applications": {
    "zotero": {
      "id": "claude-paper-buddy@zotero-plugin",
      "update_url": "https://github.com/GronuJ/zotero-paper-buddy/releases/latest/download/update.json",
      "strict_min_version": "7.0",
      "strict_max_version": "10.0.*"
    }
  },
  "homepage_url": "https://github.com/GronuJ/zotero-paper-buddy"
}
